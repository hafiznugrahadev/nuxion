{
  "name": "@nuxion/web-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- sh -c 'next dev -p \"${PORT:-${WEB_NEXT_PORT:-8080}}\"'",
    "serve": "dotenv -e ../../.env -- sh -c 'next dev -p \"${PORT:-${WEB_NEXT_PORT:-8080}}\"'",
    "build": "dotenv -e ../../.env -- next build",
    "lint": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.0",
    "@astryxdesign/theme-neutral": "0.7.0",
