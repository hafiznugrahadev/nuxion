{
  "name": "@nuxion/web-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- sh -c 'next dev -p \"${PORT:-${WEB_NEXT_PORT:-8080}}\"'",
    "serve": "dotenv -e ../../.env -- sh -c 'next dev -p \"${PORT:-${WEB_NEXT_PORT:-8080}}\"'",
    "build": "dotenv -e ../../.env -- next build",
    "lint": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^3",
    "@nuxion/shared-types": "workspace:*",
    "@radix-ui/react-slot": "^1.2.1",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/turbopack": "^4.0.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.4.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
