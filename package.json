{
  "name": "nuxion",
  "version": "0.1.0",
  "private": true,
  "description": "Nuxion — NestJS API + Nuxt 4 / Next.js 16 web monorepo (Bun + Turbo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "init": "bun run scripts/init-project.ts",
    "dev": "turbo run dev",
    "serve": "turbo run dev",
    "serve:api": "turbo run dev --filter=@nuxion/api",
    "serve:web": "turbo run dev --filter=@nuxion/web",
    "serve:web-next": "turbo run dev --filter=@nuxion/web-next",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "db:restore": "cd apps/api && bun run scripts/db-restore.ts",
    "db:restore:docker": "docker compose run --rm db-tools",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,vue,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.8",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "packageManager": "bun@1.3.3",
  "engines": {
    "bun": ">=1.3.0"
  },
  "overrides": {
    "@vue/devtools-api": "6.6.4"
  }
}
