# ╭──────────────────────────────────────────────────────────────────────────╮
# │ nuxion — SINGLE root .env for the whole monorepo                         │
# │   • docker-compose (infra + apps) reads it for variable substitution         │
# │   • apps/api  (NestJS) loads it via ConfigModule envFilePath: ../../.env      │
# │   • apps/web  (Nuxt)   loads it via `nuxt --dotenv ../../.env`                │
# │ There are no per-app .env files — keep everything here.                       │
# ╰──────────────────────────────────────────────────────────────────────────╯
#
# Networking (compose): dedicated `nuxion-network`, dibuat dan dikelola
# compose sendiri (tanpa langkah manual). Prod (docker-compose.prod.yml)
# tetap memakai `dokploy-network` milik Dokploy.

# ── Port internal container — TIDAK ada port host yang dipublish. Semua akses
#    lewat domain OrbStack (proxy HTTPS 443), jadi port ini bebas dipilih ────────
WEB_PORT=3000
API_PORT=8000

# ── Frontend URL (single source of truth — like Laravel's APP_URL) ─────────────
# Drives CORS origin and the password-reset link in emails.
# Override for custom domains, e.g. https://web.nuxion-dev.orb.local
APP_URL=http://localhost:3000

# ── API runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PREFIX=api
# CORS_ORIGIN defaults to APP_URL. Set explicitly only to override with a different
# or comma-separated list of origins.
# CORS_ORIGIN=https://app.example.com
LOG_LEVEL=debug

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_USER=nuxion
POSTGRES_PASSWORD=nuxion
POSTGRES_DB=nuxion
# Connection string for Prisma running on the HOST (bun run db:*). Tidak ada port
# host yang dipublish — gunakan domain OrbStack (TCP). Di dalam container, api/
# tools/studio mendapat URL internalnya sendiri dari docker-compose env.
DATABASE_URL=postgresql://nuxion:nuxion@nuxion-postgres.orb.local:5432/nuxion?schema=public

# ── Redis ───────────────────────────────────────────────────────────────────────
# Domain OrbStack untuk tooling di host (container memakai alamat internalnya
# sendiri dari docker-compose env).
REDIS_HOST=nuxion-redis.orb.local
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth (JWT) ──────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-me-min-16-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Self-service registration. Off by default (the kit is admin-provisioned). When
# you enable it, keep the API flag (AUTH_REGISTRATION_ENABLED) and the web flag
# (NUXT_PUBLIC_REGISTRATION_ENABLED) in sync. The docker-compose dev stack drives
# both from a single REGISTRATION_ENABLED var (defaults to true for dev).
# AUTH_REGISTRATION_ENABLED=false
# NUXT_PUBLIC_REGISTRATION_ENABLED=false
# REGISTRATION_ENABLED=true   # docker-compose only: sets both of the above

# ── Swagger docs (Basic Auth protected — change creds in prod, or disable) ───────
SWAGGER_ENABLED=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin

# ── Rate limiting (global) ──────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Skip ALL rate limiting (incl. per-route @Throttle) — handy for E2E/load tests.
# The docker-compose dev stack enables this for the api container by default.
# THROTTLE_DISABLED=false

# ── File storage (uploads) ──────────────────────────────────────────────────────
# Driver: "local" (default, zero-infra → writes to apps/api/storage/uploads and is
# served at /uploads) or "s3" (AWS S3 / MinIO / RustFS).
STORAGE_DRIVER=local
STORAGE_MAX_FILE_SIZE_MB=5
# STORAGE_LOCAL_DIR=./storage/uploads
# STORAGE_PUBLIC_BASE_URL=http://localhost:4400
# STORAGE_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif,application/pdf
# With STORAGE_DRIVER=s3 the bucket stays PRIVATE: objects are served via short-lived
# presigned GET URLs behind a stable proxy (GET /api/files/view?key=…). The presigned
# URL is cached in Redis (keyed by object key) for ~this TTL minus a margin, so it's
# regenerated at most once per window rather than on every request.
STORAGE_SIGNED_URL_TTL_SECONDS=3600
#
# S3 / RustFS / MinIO — only used when STORAGE_DRIVER=s3:
# S3_ENDPOINT=http://nuxion-rustfs:9000  # endpoint the API uses for put/get/delete
#                                        # (in Docker: the container_name host — dasar
#                                        # domain OrbStack untuk tooling host — bukan
#                                        # nama service `rustfs`). Omit for real AWS.
# S3_REGION=us-east-1
# S3_BUCKET=nuxion
# S3_ACCESS_KEY_ID=rustfsadmin
# S3_SECRET_ACCESS_KEY=rustfsadmin
# S3_FORCE_PATH_STYLE=true               # required by RustFS/MinIO
# S3_PUBLIC_BASE_URL=https://rustfs.nuxion-dev.orb.local/nuxion  # browser-reachable
#                                        # <endpoint>/<bucket>; also the endpoint presigned
#                                        # GET URLs are signed for

# ── Database backups (db:restore) ───────────────────────────────────────────────
# The bucket where your backup job (e.g. Dokploy) drops `pg_dump | gzip` files.
# This app never WRITES backups — it only lists and restores them.
# You configure credentials + bucket only; WHICH folder/dump to restore is picked
# interactively at run time (`bun run db:restore` browses the bucket).
# Generic S3 naming — the same vars work for RustFS, MinIO, or real AWS S3. Keep
# this bucket SEPARATE from the uploads bucket (S3_* above) so dumps are never
# reachable through the app's file routes.
BACKUP_DRIVER=s3                       # s3 (default) | local (a folder on disk, dev)
# db:restore runs on the HOST, so point this at a host-reachable endpoint —
# with no published ports that means the OrbStack domain
# (http://nuxion-rustfs.orb.local:9000) — not the in-compose container_name
# host (nuxion-rustfs:9000).
# BACKUP_S3_ENDPOINT=http://nuxion-rustfs.orb.local:9000
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_BUCKET=nuxion-backups
# BACKUP_S3_ACCESS_KEY_ID=rustfsadmin
# BACKUP_S3_SECRET_ACCESS_KEY=rustfsadmin
# BACKUP_S3_FORCE_PATH_STYLE=true      # required by RustFS/MinIO
# BACKUP_S3_PREFIX=                    # optional: folder browsing STARTS in, e.g. "postgres/"
# BACKUP_LOCAL_DIR=./storage/backups   # used when BACKUP_DRIVER=local
# BACKUP_RESTORE_UI_ENABLED=false      # gate the admin restore endpoint/UI
#
# Requires the `psql` binary on the machine running the restore
# (macOS: brew install libpq && brew link --force libpq).

# ── Mail ────────────────────────────────────────────────────────────────────────
# Transport: "log" (default — emails written to the API logs, zero-infra) or "smtp".
# NOTE: the docker-compose dev stack overrides this to smtp → the Mailpit container
# (web UI at http://mailpit.nuxion-dev.orb.local:8025 — via domain OrbStack,
# bukan port host). These values apply to non-docker/local runs.
MAIL_TRANSPORT=log
MAIL_FROM=Nuxion <no-reply@nuxion.test>
# SMTP — only used when MAIL_TRANSPORT=smtp (e.g. point at Mailpit from the host):
# MAIL_SMTP_HOST=nuxion-mailpit.orb.local
# MAIL_SMTP_PORT=1025
# MAIL_SMTP_SECURE=false
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=

# ── Password reset ──────────────────────────────────────────────────────────────
PASSWORD_RESET_TTL_MIN=30
# Reset link is built from APP_URL + /reset-password — no separate variable needed.

# ── Web (Nuxt) — public, exposed to the browser ─────────────────────────────────
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# ╭──────────────────────────────────────────────────────────────────────────╮
# │ PROD (docker-compose.prod.yml) — set these in the Dokploy UI. Postgres/Redis │
# │ are provisioned by Dokploy, so point DATABASE_URL / REDIS_HOST at those.      │
# ╰──────────────────────────────────────────────────────────────────────────╯
# DATABASE_URL=postgresql://USER:PASS@nuxion-db:5432/nuxion?schema=public
# REDIS_HOST=nuxion-redis
# APP_URL=https://app.example.com
# NUXT_PUBLIC_API_BASE=https://api.example.com/api
