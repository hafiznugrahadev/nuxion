    "@hookform/resolvers": "^3",
    "@nuxion/shared-types": "workspace:*",
    "@simplewebauthn/browser": "^14",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.5",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7",
