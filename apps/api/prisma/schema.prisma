// Prisma schema for nuxion.
// Prisma 7: Rust-free `prisma-client` generator + a driver adapter at runtime
// (see prisma.service.ts). The client is generated into src/ so nest build emits it.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL lives in prisma.config.ts (Migrate) and the
  // driver adapter (runtime). It is no longer set here.
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  password      String
  avatarUrl     String?        // public URL of the user's avatar (storage module)
  // TOTP two-factor. The secret is AES-256-GCM encrypted at rest (two-factor.service.ts);
  // twoFactorEnabled only flips to true once activation is confirmed with a valid code.
  twoFactorEnabled Boolean     @default(false)
  twoFactorSecret  String?
  recoveryCodes    String?     // JSON array of SHA-256 hashes; plaintext is shown once
  // Many-to-many: a user can hold multiple roles (scalable RBAC).
  roles               Role[]               @relation("UserRoles")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]
  passkeys            Passkey[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("users")
}

model Passkey {
  id         String    @id // base64url credential ID from the authenticator
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  publicKey  String    // base64url COSE public key
  counter    BigInt    @default(0) // signature counter (clone detection)
  transports String[]  @default([]) // internal | hybrid | nfc | smart-card | usb
  deviceType String?   // singleDevice | multiDevice
  backedUp   Boolean   @default(false)
  name       String?   // user label, e.g. "MacBook Touch ID"
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("passkeys")
}

// App-wide settings grouped by key (e.g. 'branding'). The row's value shape is
// validated by the settings module's DTOs — new groups need no schema migration.
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String    @default("info") // info | success | warning | error
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. ADMIN, USER — add rows without code changes
  users     User[]   @relation("UserRoles")
  createdAt DateTime @default(now())

  @@map("roles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  familyId  String // tokens rotated from one login share a family (reuse detection)
  tokenHash String    @unique // SHA-256 of the opaque token (raw value never stored)
  revokedAt DateTime? // set on rotation/logout; a non-null value means unusable
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique // SHA-256 of the opaque token (raw value never stored)
  usedAt    DateTime? // set once the token is consumed; a non-null value means spent
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}
