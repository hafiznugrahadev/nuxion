    "@playwright/test": "^1.60.0",
    "@tailwindcss/turbopack": "^4.0.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.4.0",
    "happy-dom": "^20.14.5",
    "otplib": "^13.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
